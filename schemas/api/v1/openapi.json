{
  "openapi": "3.1.0",
  "info": {
    "title": "Observatory research API",
    "version": "1.0.0",
    "description": "Private loopback research slice; oc.research.v1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Liveness"
          }
        }
      }
    },
    "/v1/research/invoke": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "operation",
                  "arguments"
                ],
                "properties": {
                  "version": {
                    "const": "oc.research.v1"
                  },
                  "operation": {
                    "enum": [
                      "searchEvidence",
                      "getDocument",
                      "verifyCitation"
                    ]
                  },
                  "arguments": {
                    "type": "object"
                  }
                },
                "oneOf": [
                  {
                    "properties": {
                      "operation": {
                        "const": "searchEvidence"
                      },
                      "arguments": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "query"
                        ],
                        "properties": {
                          "query": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "operation": {
                        "const": "getDocument"
                      },
                      "arguments": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "documentId"
                        ],
                        "properties": {
                          "documentId": {
                            "type": "string",
                            "pattern": "^doc-[a-f0-9]{64}$"
                          }
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "operation": {
                        "const": "verifyCitation"
                      },
                      "arguments": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "documentId",
                          "start",
                          "end",
                          "quotedText"
                        ],
                        "properties": {
                          "documentId": {
                            "type": "string",
                            "pattern": "^doc-[a-f0-9]{64}$"
                          },
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "quotedText": {
                            "type": "string",
                            "maxLength": 10000
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SDK research response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "405": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "408": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "415": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Bounded error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
